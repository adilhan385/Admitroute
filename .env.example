# AdmitRoute — Environment Variables Template
# Скопируйте этот файл в .env и укажите ваши боевые значения.
# НИКОГДА не коммитьте файл .env в git!

# 1. Подключение к базе данных PostgreSQL (Neon / Supabase / Self-hosted)
# Серверный секрет (без префикса VITE_), доступен только в Serverless API
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# 2. Google Gemini AI API Key (серверная переменная, без VITE_)
# Получить бесплатно: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Учётная запись Главного Администратора
ADMIN_EMAIL=admin@admitroute.kz
VITE_ADMIN_EMAIL=admin@admitroute.kz
ADMIN_INITIAL_PASSWORD=change_this_strong_admin_password_123!

# 4. Секретный ключ для подписи сессий и токенов (минимум 32 символа)
JWT_SECRET=your_random_32_characters_secret_string_here_12345
